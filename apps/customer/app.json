{
  "expo": {
    "name": "NearBy",
    "slug": "nearby-customer",
    "version": "1.0.0",
    "updates": {
      "enabled": false
    },
    "orientation": "portrait",
    "scheme": "nearby-customer",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E35D23"
    },
    "ios": {
      "buildNumber": "1",
      "bundleIdentifier": "app.nearby.customer",
      "supportsTablet": false
    },
    "android": {
      "versionCode": 1,
      "package": "app.nearby.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E35D23"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "NearBy needs your location to show shops near you.",
          "locationWhenInUsePermission": "NearBy needs your location to show shops near you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#E35D23",
          "androidMode": "default",
          "androidCollapsedTitle": "NearBy"
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
